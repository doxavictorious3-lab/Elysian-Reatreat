# Copy to .env and fill in. Never commit .env.
PORT=4000
# Where your website runs (browser origin allowed to call this API)
CLIENT_ORIGIN=http://localhost:5173
# Optional email delivery. Leave SMTP_HOST empty to only save submissions to server/data/
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Elysian Retreat <no-reply@example.com>
MAIL_TO=reservations@example.com

# Staff area (/staff on the website). Use a long, unique password.
# Generate the secret with:  openssl rand -hex 32
ADMIN_PASSWORD=
ADMIN_TOKEN_SECRET=
