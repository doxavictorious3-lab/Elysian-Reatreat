# Copy to .env and fill in. Never commit .env.
PORT=4000
# Where your website runs (browser origin allowed to call this API)
CLIENT_ORIGIN=http://localhost:5173
# Database file (SQLite). Default: data/elysian.db. On a host, point this at a persistent disk.
DB_PATH=data/elysian.db
# Secret used to sign admin login sessions. Generate with:  openssl rand -hex 32
ADMIN_TOKEN_SECRET=
# Optional email alerts to your team. Leave SMTP_HOST empty to skip email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Elysian Retreat <no-reply@example.com>
MAIL_TO=reservations@example.com
